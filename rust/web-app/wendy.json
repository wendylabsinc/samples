{
    "appId": "com.example.rust-web-app",
    "version": "0.0.1",
    "entitlements": [
        {
            "type": "network"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 4002 },
        "timeoutSeconds": 30
