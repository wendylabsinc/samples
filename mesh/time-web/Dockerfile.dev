# Local Docker image: the app uses a daemon inside this container.
FROM golang:1.24-bookworm AS builder
RUN apt-get update && apt-get install -y --no-install-recommends \
    libavahi-compat-libdnssd-dev dbus avahi-daemon && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download
COPY *.go avahi_shim.c ./
RUN CGO_ENABLED=1 go build -o /app/time-web .
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    libavahi-compat-libdnssd1 avahi-daemon dbus && rm -rf /var/lib/apt/lists/*
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh
COPY --from=builder /app/time-web /usr/local/bin/time-web
EXPOSE 8081/tcp
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
