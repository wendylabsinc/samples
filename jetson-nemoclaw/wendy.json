{
  "appId": "sh.wendy.samples.nemoclaw-v9",
  "version": "0.2.0",
  "platform": "linux",
  "services": {
    "ollama": {
      "context": "./ollama",
      "entitlements": [
        {
          "type": "gpu"
        },
        {
          "type": "network",
          "mode": "host"
        },
        {
          "type": "persist",
          "name": "nemoclaw-models",
          "path": "/models"
        }
      ]
    },
    "agent": {
      "context": "./agent",
      "dependsOn": [
        "ollama"
      ],
      "entitlements": [
        {
          "type": "build"
        },
        {
          "type": "admin"
        },
        {
          "type": "gpu"
        },
        {
          "type": "network",
          "mode": "host"
        },
        {
          "type": "persist",
          "name": "nemoclaw-home",
          "path": "/root"
        },
        {
          "type": "persist",
          "name": "nemoclaw-docker",
          "path": "/var/lib/docker"
        },
        {
          "type": "persist",
          "name": "nemoclaw-workspace",
          "path": "/workspace"
        }
      ]
    }
  }
}
