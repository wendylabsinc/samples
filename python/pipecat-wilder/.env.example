# Runtime profile: auto, jetson, mac, or generic.
WILDER_PROFILE=auto
WILDER_VERBOSE_PIPECAT=false
WILDER_PRELOAD_MODELS=true
ENABLE_WEB_SEARCH=true

# Gemini
GOOGLE_API_KEY=replace-me
GOOGLE_MODEL=gemini-3.1-flash-lite-preview
GOOGLE_TEMPERATURE=0.35
GOOGLE_MAX_TOKENS=256
# Leave empty to disable Gemini 3.x thinking for lower latency.
GOOGLE_THINKING_LEVEL=

# Assistant persona
ASSISTANT_NAME=Wilder

# Local STT (Whisper / Faster-Whisper through Pipecat)
WHISPER_MODEL=base
# Optional pre-baked Whisper model directory, used by container images that ship model assets.
# WHISPER_MODEL_PATH=/opt/wilder/models/whisper
WHISPER_LANGUAGE=en
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto
WHISPER_NO_SPEECH_PROB=0.55

# Local TTS (Kokoro through Pipecat)
KOKORO_VOICE=am_liam
KOKORO_LANGUAGE=en-US
KOKORO_CACHE_DIR=.cache/kokoro
# Optional pre-baked Kokoro asset paths, used by container images that ship model assets.
# KOKORO_MODEL_PATH=/opt/wilder/models/kokoro/kokoro-v1.0.onnx
# KOKORO_VOICES_PATH=/opt/wilder/models/kokoro/voices-v1.0.bin

# Headless local audio mode. Leave unset to use the system defaults.
# You can list device indices with: uv run wilder-voice --list-audio-devices
# LOCAL_AUDIO_INPUT_DEVICE_INDEX=
# LOCAL_AUDIO_OUTPUT_DEVICE_INDEX=
# LOCAL_AUDIO_INPUT_DEVICE_NAME=Anker
# LOCAL_AUDIO_OUTPUT_DEVICE_NAME=Anker

# Docker build arg for Jetson images. Match this to your device's L4T release.
# Example: r36.4.0 for JetPack 6.1-era devices.
L4T_TAG=r36.4.0
