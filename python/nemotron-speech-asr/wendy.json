{
    "appId": "sh.wendy.examples.nemotron-speech-asr",
    "version": "1.0.0",
    "language": "python",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "audio"
        },
        {
            "type": "gpu"
        },
        {
            "type": "persist",
            "name": "model-cache",
            "path": "/root/.cache"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 3004 },
        "timeoutSeconds": 30
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:3004"
        }
    }
}
