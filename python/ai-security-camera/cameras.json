{
  "_comment": "Security cameras to monitor. Plug your IP camera into the Jetson's Ethernet port (or the same LAN) and point 'url' at its RTSP stream. You can override the whole list at runtime with the CAMERA_URLS env var (comma-separated RTSP URLs).",
  "_examples": {
    "reolink_main": "rtsp://<user>:<pass>@<camera-ip>:554/h264Preview_01_main",
    "reolink_sub": "rtsp://<user>:<pass>@<camera-ip>:554/h264Preview_01_sub",
    "amcrest_dahua": "rtsp://<user>:<pass>@<camera-ip>:554/cam/realmonitor?channel=1&subtype=0",
    "hikvision": "rtsp://<user>:<pass>@<camera-ip>:554/Streaming/Channels/101",
    "onvif_generic": "rtsp://<user>:<pass>@<camera-ip>:554/stream1"
  },
  "cameras": [
    {
      "name": "front-door",
      "url": "rtsp://admin:password@192.168.1.108:554/h264Preview_01_main",
      "enabled": true
    }
  ]
}
