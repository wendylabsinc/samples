{
  "appId": "rosmaster-a1-lidar",
  "version": "0.2.3",
  "platform": "linux",
  "services": {
    "base": {
      "context": ".",
      "entitlements": [
        {
          "type": "network",
          "mode": "host"
        },
        {
          "type": "usb"
        },
        {
          "type": "serial",
          "device": "ttyUSB0"
        },
        {
          "type": "camera"
        },
        {
          "type": "input"
        },
        {
          "type": "audio"
        }
      ],
      "frameworks": {
        "ros2": {
          "domainId": 0,
          "rmw": "rmw_cyclonedds_cpp",
          "distro": "humble"
        }
      }
    }
  }
}
