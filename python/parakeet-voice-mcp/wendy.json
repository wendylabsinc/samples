{
    "appId": "sh.wendy.examples.parakeet-voice-mcp",
    "version": "0.0.1",
    "env": {
        "ACTION_MODE": "observe",
        "CONTINUOUS_TRANSCRIPTION": "1",
        "AUDIO_DEVICE": "DJI MIC MINI"
    },
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "audio"
        },
        {
            "type": "persist",
            "name": "parakeet-voice-mcp-models",
            "path": "/models"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 8080 },
        "timeoutSeconds": 600
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:8080"
        }
    }
}
