{
    "appId": "sh.wendy.examples.parakeet-live-transcribe",
    "version": "0.0.1",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "audio"
        },
        {
            "type": "persist",
            "name": "parakeet-models",
            "path": "/models"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 8080 },
        "timeoutSeconds": 600
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:8080"
        }
    }
}
