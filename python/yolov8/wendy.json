{
  "appId": "com.example.python-yolov8",
  "version": "0.0.1",
  "defaultProfile": "local-dev-macos-arm64",
  "entitlements": [
    {
      "type": "network",
      "mode": "host"
    },
    {
      "type": "gpu"
    },
    {
      "type": "video"
    },
    {
      "type": "persist",
      "name": "app-yolov8-models",
      "path": "/models"
    }
  ],
  "profiles": [
    {
      "id": "local-dev-macos-arm64",
      "when": {
        "target": "local",
        "os": "macos",
        "arch": "arm64"
      },
      "run": {
        "type": "host",
        "command": "cd server && MODELS_DIR=../models uv run --with-requirements requirements.txt app.py"
      }
    },
    {
      "id": "local-dev-macos-x86_64",
      "when": {
        "target": "local",
        "os": "macos",
        "arch": "x86_64"
      },
      "run": {
        "type": "host",
        "command": "cd server && MODELS_DIR=../models uv run --with-requirements requirements.txt app.py"
      }
    },
    {
      "id": "local-dev-linux-arm64",
      "when": {
        "target": "local",
        "os": "linux",
        "arch": "arm64"
      },
      "run": {
        "type": "host",
        "command": "cd server && MODELS_DIR=../models python3 app.py"
      }
    },
    {
      "id": "device-default",
      "when": {
        "target": "device"
      },
      "build": {
        "type": "docker"
      },
      "run": {
        "type": "container"
      }
    }
  ]
}
