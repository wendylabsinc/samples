{
  "appId": "com.example.python-yolov8",
  "version": "0.0.1",
  "defaultProfile": "local-dev-macos-arm64",
  "entitlements": [
    {
      "type": "network",
      "mode": "host"
    },
    {
      "type": "gpu"
    },
    {
      "type": "video"
    },
    {
      "type": "persist",
      "name": "app-yolov8-models",
      "path": "/models"
    }
  ],
  "profiles": [
    {
      "id": "local-dev-macos-arm64",
      "when": {
        "target": "local",
        "os": "macos",
        "arch": "arm64"
      },
      "run": {
        "type": "host",
        "command": "cd server && MODELS_DIR=../models uv run --with-requirements requirements.txt app.py"
      },
      "hooks": {
        "preBuild": [
          {
            "name": "Show build context",
            "command": "echo Building {{profile.id}} for {{target.platform}}"
          }
        ],
        "postBuild": [],
        "preRun": [
          {
            "name": "Show run context",
            "command": "echo Running {{profile.id}} on {{target.kind}} {{device.host}}"
          }
        ],
        "postRun": [],
        "preStop": [
          {
            "name": "Best-effort cleanup",
            "command": "echo Stopping {{profile.id}}",
            "continueOnError": true
          }
        ]
      }
    },
    {
      "id": "local-dev-macos-x86_64",
      "when": {
        "target": "local",
        "os": "macos",
        "arch": "x86_64"
      },
      "run": {
        "type": "host",
        "command": "cd server && MODELS_DIR=../models uv run --with-requirements requirements.txt app.py"
      },
      "hooks": {
        "preBuild": [
          {
            "name": "Show build context",
            "command": "echo Building {{profile.id}} for {{target.platform}}"
          }
        ],
        "postBuild": [],
        "preRun": [
          {
            "name": "Show run context",
            "command": "echo Running {{profile.id}} on {{target.kind}} {{device.host}}"
          }
        ],
        "postRun": [],
        "preStop": [
          {
            "name": "Best-effort cleanup",
            "command": "echo Stopping {{profile.id}}",
            "continueOnError": true
          }
        ]
      }
    },
    {
      "id": "local-dev-linux-arm64",
      "when": {
        "target": "local",
        "os": "linux",
        "arch": "arm64"
      },
      "run": {
        "type": "host",
        "command": "cd server && MODELS_DIR=../models python3 app.py"
      },
      "hooks": {
        "preBuild": [
          {
            "name": "Show build context",
            "command": "echo Building {{profile.id}} for {{target.platform}}"
          }
        ],
        "postBuild": [],
        "preRun": [
          {
            "name": "Show run context",
            "command": "echo Running {{profile.id}} on {{target.kind}} {{device.host}}"
          }
        ],
        "postRun": [],
        "preStop": [
          {
            "name": "Best-effort cleanup",
            "command": "echo Stopping {{profile.id}}",
            "continueOnError": true
          }
        ]
      }
    },
    {
      "id": "device-default",
      "when": {
        "target": "device"
      },
      "build": {
        "type": "docker",
        "platform": "{{target.platform}}",
        "buildArgs": {
          "TARGET_PLATFORM": "{{target.platform}}",
          "TARGET_KIND": "{{target.kind}}"
        },
        "env": {
          "DOCKER_BUILDKIT": "1"
        }
      },
      "run": {
        "type": "container"
      },
      "hooks": {
        "preBuild": [
          {
            "name": "Show build context",
            "command": "echo Building {{profile.id}} for {{target.platform}}"
          }
        ],
        "postBuild": [],
        "preRun": [
          {
            "name": "Show run context",
            "command": "echo Running {{profile.id}} on {{target.kind}} {{device.host}}"
          }
        ],
        "postRun": [],
        "preStop": [
          {
            "name": "Best-effort cleanup",
            "command": "echo Stopping {{profile.id}}",
            "continueOnError": true
          }
        ]
      }
    }
  ]
}
