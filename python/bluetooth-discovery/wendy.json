{
    "appId": "sh.wendy.examples.bluetooth-discovery",
    "version": "1.0.0",
    "language": "python",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "bluetooth",
            "mode": "bluez"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 8000 },
        "timeoutSeconds": 30
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:8000"
        }
    }
}
