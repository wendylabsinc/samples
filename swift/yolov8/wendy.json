{
    "appId": "sh.wendy.examples.swift-yolov8",
    "version": "1.0.0",
    "language": "swift",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "video"
        },
        {
            "type": "gpu"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 3004 },
        "timeoutSeconds": 30
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:3004"
        }
    }
}
