{
    "appId": "com.example.swift-mlx-llm-example",
    "version": "0.0.1",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "gpu"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 6002 },
        "timeoutSeconds": 60
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:6002"
        }
    }
}
