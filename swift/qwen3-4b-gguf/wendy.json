{
    "appId": "sh.wendy.examples.qwen3-chat",
    "version": "0.1.0",
    "entitlements": [
        {
            "type": "network",
            "mode": "host"
        },
        {
            "type": "gpu"
        }
    ],
    "readiness": {
        "tcpSocket": { "port": 6002 },
        "timeoutSeconds": 30
    },
    "hooks": {
        "postStart": {
            "cli": "open http://${WENDY_HOSTNAME}:6002"
        }
    }
}
